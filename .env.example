# Copia questo file in .env e inserisci i valori del TUO progetto Supabase.
# Dashboard Supabase → Project Settings → API Keys.
#
# Questi valori finiscono nel bundle JavaScript pubblico: usa SOLO la
# publishable key (sb_publishable_…) oppure la legacy anon key.
# MAI la secret key (sb_secret_…) o la service_role key.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<la-tua-chiave>

# In alternativa alla publishable key, la legacy anon key (JWT):
# VITE_SUPABASE_ANON_KEY=<anon-key>
